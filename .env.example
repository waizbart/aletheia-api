DATABASE_URL=postgres://aletheia:aletheia@localhost:5432/aletheia?sslmode=disable
RPC_URL=http://127.0.0.1:8545
FROM_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
SERVER_PORT=8080
# Comma-separated list of origins allowed via CORS. "*" permits any origin
# (safe here: the API uses no cookies/credentials). Restrict in production.
CORS_ALLOWED_ORIGINS=*
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=aletheia-images
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
# Observabilidade. Deixe OTEL_EXPORTER_OTLP_ENDPOINT em branco para rodar local
# sem Jaeger (os spans viram no-op). Com docker compose use "jaeger:4318".
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=aletheia-api
# Quantidade de traces recentes mantidos em memória para o painel /observability.
OBS_RING_CAPACITY=50

# Autenticação por API key (obrigatório). Formato "chave:identidade,chave2:id2".
# A identidade autenticada vira o registrante do certificado.
API_KEYS=dev-local-key:local-dev

# Rate limiting (token bucket por chave/IP).
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# Pool de conexões do Postgres.
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

# Timeouts do servidor HTTP (durations Go: 30s, 2m, ...).
HTTP_READ_TIMEOUT=30s
HTTP_READ_HEADER_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=120s
HTTP_IDLE_TIMEOUT=120s

# Worker de anchoring assíncrono on-chain (outbox).
ANCHOR_WORKER_INTERVAL=2s
ANCHOR_WORKER_BATCH=16
ANCHOR_MAX_ATTEMPTS=5
