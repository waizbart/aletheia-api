DATABASE_URL=postgres://aletheia:aletheia@localhost:5432/aletheia?sslmode=disable
RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
SERVER_PORT=8080
# Comma-separated list of origins allowed via CORS. "*" permits any origin
# (safe here: the API uses no cookies/credentials). Restrict in production.
CORS_ALLOWED_ORIGINS=*

# --- Admin access -----------------------------------------------------------
# Bearer token guarding certificate deletion and the observability dashboard.
# Leaving it blank does NOT disable the guard: those routes then reject every
# request. Generate with: openssl rand -hex 32
ADMIN_API_TOKEN=

# --- Abuse controls ---------------------------------------------------------
# Sustained requests per second per client IP, and the burst allowance on top.
# Set RATE_LIMIT_RPS=0 to disable limiting (local development only).
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
# Requests allowed in flight at once. Upload routes decode whole images into
# memory, so this is the practical bound on peak memory.
MAX_CONCURRENT_REQUESTS=32
# Honour X-Forwarded-For / X-Real-Ip when resolving the client IP. Enable ONLY
# behind a reverse proxy you control — otherwise any caller can forge a fresh
# identity per request and walk straight past the rate limiter.
TRUST_PROXY_HEADERS=false
# Observabilidade. Deixe OTEL_EXPORTER_OTLP_ENDPOINT em branco para rodar local
# sem Jaeger (os spans viram no-op). Com docker compose use "jaeger:4318".
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=aletheia-api
# Quantidade de traces recentes mantidos em memória para o painel /observability.
OBS_RING_CAPACITY=50

# --- Attested capture -------------------------------------------------------
# PEM bundle of the Google hardware attestation roots. Without a pinned root a
# self-signed chain would verify and the check would be decorative.
ANDROID_ATTESTATION_ROOTS=./config/android-attestation-roots.pem
# Application IDs allowed to enrol devices, comma-separated.
ANDROID_ALLOWED_PACKAGES=com.aletheia.camera
# Hex SHA-256 digests of the APK signing certificates, comma-separated. A
# package name alone is trivially spoofed by a repackaged app.
ANDROID_SIGNATURE_DIGESTS=
# Weakest acceptable key location: "tee" (default) or "strongbox".
ANDROID_MIN_ATTESTATION_LEVEL=tee
# Reject unlocked or tampered bootloaders. Disable only for lab devices on an
# isolated registry.
ANDROID_REQUIRE_VERIFIED_BOOT=true
# How long a capture challenge stays usable. Keep it short: the window between
# asking for a challenge and uploading the capture is seconds.
CAPTURE_NONCE_TTL=5m

# --- Legacy upload path -----------------------------------------------------
# Re-opens POST /certificates for uploads with no capture-time provenance.
# Off by default: an upload nobody vouched for is what attested capture exists
# to replace. Enable only while migrating an integration onto the SDK.
ALLOW_UNATTESTED_CERTIFY=false

# --- Anchoring --------------------------------------------------------------
# secp256k1 key of the anchoring account. Fund it on the target chain; the
# address is logged at startup.
ANCHOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# EIP-155 chain id: 137 for Polygon, 31337 for the local Anvil node.
CHAIN_ID=31337
# How often the worker commits a batch. The cost of an anchor does not change
# with the number of certificates under it, so a longer interval is cheaper.
ANCHOR_INTERVAL=1h
# Maximum certificates per batch. Larger batches are no more expensive, but the
# proof each certificate carries grows with log2(size).
ANCHOR_BATCH_SIZE=4096
ANCHOR_GAS_LIMIT=120000
